# Postgres connection string.
# Local Postgres 16 on this machine listens on port 5433.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/flux

# How many connections the pool may open. This is the real ceiling on how many
# transfers are genuinely concurrent inside Postgres during the benchmark.
DB_POOL_MAX=40

# Simulated business logic latency between the read and the write in the naive
# strategy. Defaults to 0; raise it to widen the race window on purpose.
NAIVE_THINK_MS=0
