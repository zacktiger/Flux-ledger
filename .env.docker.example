# Copy to .env (which Docker Compose reads automatically) to override the
# defaults baked into compose.yaml. None of these are required.

# Password for the containerised Postgres. The database is only reachable on
# localhost, so the default is fine for a demo; change it before exposing it.
POSTGRES_PASSWORD=postgres

# Host ports. 5439 avoids the Postgres instances already listening on
# 5432-5435 on the development machine.
DB_PORT=5439
WEB_PORT=3000

# How many transfers are genuinely concurrent inside Postgres during the
# benchmark. Changing it changes the results.
DB_POOL_MAX=40

# Widen the naive strategy's race window on purpose:
#   NAIVE_THINK_MS=25 docker compose run --rm bench --strategies=naive
NAIVE_THINK_MS=0
